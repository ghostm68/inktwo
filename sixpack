<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WORDSTAR // TEN</title>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <style>
        :root {
            --bg-color: #000000;
            --text-color: #d1d1d1;
            --accent-color: #ff0033; 
            --terminal-green: #15ff00; /* Optional: for a matrix/wordstar feel */
        }

        body, html {
            margin: 0;
            padding: 0;
            background: var(--bg-color);
            color: var(--text-color);
            font-family: 'Courier New', Courier, monospace;
            overflow-x: hidden;
        }

        /* DAMAGED PROJECTOR FLICKER */
        @keyframes intenseFlicker {
            0% { opacity: 0.95; filter: contrast(110%); }
            2% { opacity: 0.6; filter: brightness(2) contrast(150%); transform: scale(1.002); }
            4% { opacity: 0.9; transform: translateX(1px); }
            10% { opacity: 0.95; }
            90% { opacity: 0.9; transform: translateX(-1px); }
            95% { opacity: 0.5; filter: invert(5%); }
            100% { opacity: 0.95; }
        }

        .flicker { animation: intenseFlicker 0.2s infinite; }

        /* HORIZONTAL ENGINE */
        .scroll-height {
            height: 1000vh; /* 10 Panels = 1000vh */
        }

        .viewport {
            position: sticky;
            top: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .track {
            display: flex;
            width: 1000vw; /* 10 panels */
            height: 100vh;
            will-change: transform;
        }

        /* THE PANEL DESIGN */
        .panel {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-shrink: 0;
            border-right: 1px solid #111;
        }

        .art-side {
            width: 55%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            padding: 40px;
        }

        .art-side img {
            max-height: 85vh;
            max-width: 90%;
            object-fit: contain;
            filter: grayscale(20%);
        }

        .text-side {
            width: 45%;
            height: 100%;
            background: #050505;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
            border-left: 1px solid #222;
        }

        .file-header {
            color: var(--accent-color);
            font-size: 12px;
            letter-spacing: 4px;
            margin-bottom: 30px;
            border-bottom: 1px solid var(--accent-color);
            display: inline-block;
            padding-bottom: 5px;
        }

        /* THE PRE TAG - TERMINAL STYLE */
        pre {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.1rem;
            line-height: 1.6;
            color: var(--text-color);
            white-space: pre-wrap; /* Critical: wraps text but keeps your spacing */
            word-wrap: break-word;
            background: rgba(0,0,0,0.3);
            padding: 20px;
            border-left: 1px solid #333;
        }

        /* OVERLAYS */
        .scanlines {
            position: fixed;
            top:0; left:0; width:100%; height:100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            background-size: 100% 3px, 2px 100%;
            pointer-events: none;
            z-index: 100;
        }
    </style>
</head>
<body>

    <div class="scanlines"></div>

    <main class="scroll-height">
        <div class="viewport">
            <div class="track">
                
                <!-- START OF PANELS (Repeat 10 Times) -->
                
                <!-- PANEL 01 -->
                <section class="panel">
                    <div class="art-side">
                        <img src="https://raw.githubusercontent.com/ghostm68/pantheon/main/clarknova.inkrealm.info.ai123164f.gif" class="flicker">
                    </div>
                    <div class="text-side">
                        <div class="file-header">ENTRY_LOG_01</div>
                        <pre>
THE CLARK NOVA INTERFACE.
-------------------------
IT WAS THE KIND OF CODE THAT BLED.
SITTING IN THE DARK, 
THE GREEN CURSOR BLINKING LIKE
A STEADY HEARTBEAT IN A 
DEAD ROOM.
                        </pre>
                    </div>
                </section>

                <!-- PANEL 02 -->
                <section class="panel">
                    <div class="art-side">
                        <img src="https://raw.githubusercontent.com/ghostm68/pantheon/main/slutpuppy1%20November%2018,%202025%20-%2010_02PM%20(3).png" class="flicker">
                    </div>
                    <div class="text-side">
                        <div class="file-header">ENTRY_LOG_02</div>
                        <pre>
THE SLUTPUPPY.
--------------
SHE DIDN'T JUST ENTER THE SYSTEM.
SHE REWROTE THE PERIPHERALS.

A SLIDING PIMPCAT IN A
LOW-RES WORLD.
                        </pre>
                    </div>
                </section>

                <!-- Add Panels 03 - 10 here using the same structure -->

            </div>
        </div>
    </main>

    <script>
        gsap.registerPlugin(ScrollTrigger);

        const track = document.querySelector(".track");
        const panels = gsap.utils.toArray(".panel");

        // The Scroll Animation
        gsap.to(track, {
            xPercent: -100 * (panels.length - 1),
            ease: "none",
            scrollTrigger: {
                trigger: ".scroll-height",
                pin: true,
                scrub: 1, // High-end 'sliding' feel
                end: () => "+=" + track.offsetWidth
            }
        });

        // Add a subtle 'peek' animation for the text
        panels.forEach((panel) => {
            const pre = panel.querySelector("pre");
            gsap.from(pre, {
                opacity: 0,
                x: 50,
                duration: 0.5,
                scrollTrigger: {
                    trigger: panel,
                    containerAnimation: gsap.getProperty(track, "x"),
                    start: "left center",
                    toggleActions: "play none none reverse"
                }
            });
        });
    </script>
</body>
</html>
